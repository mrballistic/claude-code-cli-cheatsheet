---
/** MCP: adding servers, scopes, popular servers, managing, and building one. */
import Cmd from './Cmd.astro';
import CommandTable from './CommandTable.astro';
import FileBlock from './FileBlock.astro';
import SectionHeading from './SectionHeading.astro';
import { COMMANDS_COPY, MCP } from '@/lib/constants';
---

<section class="section reveal">
  <SectionHeading id="mcp" title={MCP.title} lede={MCP.description} />

  <h3 class="sub-title mb-4">{MCP.addTitle}</h3>
  <ul class="grid gap-3">
    {MCP.addServerExamples.map((c) => (
      <li>
        <p class="mb-1.5 text-sm muted">{c.description}</p>
        <Cmd command={c.command} />
      </li>
    ))}
  </ul>

  <h3 class="sub-title mt-12 mb-4">{MCP.scopesTitle}</h3>
  <div class="overflow-x-auto">
    <table class="ref-table">
      <caption class="sr-only">{MCP.scopesTitle}</caption>
      <thead>
        <tr>
          <th scope="col">{MCP.scopeHeaders.scope}</th>
          <th scope="col">{MCP.scopeHeaders.location}</th>
          <th scope="col">{MCP.scopeHeaders.description}</th>
        </tr>
      </thead>
      <tbody>
        {MCP.scopes.map((s) => (
          <tr>
            <th scope="row" class="text-left font-normal">
              <span class="font-bold">{s.scope}</span>
              <code class="block text-xs text-ink-3">{s.flag}</code>
            </th>
            <td><code class="cell-code">{s.location}</code></td>
            <td class="desc">{s.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class="sub-title mt-12 mb-4">{MCP.serversTitle}</h3>
  <ul class="grid gap-6">
    {MCP.commonServers.map((s) => (
      <li>
        <p class="mb-1.5"><span class="font-bold">{s.name}</span> <span class="text-ink-2">· {s.description}</span></p>
        <Cmd command={s.installCommand} />
      </li>
    ))}
  </ul>

  <div class="mt-12 grid gap-10 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div class="min-w-0">
      <h3 class="sub-title mb-4">{MCP.manageTitle}</h3>
      <CommandTable
        rows={MCP.managingCommands.map((c) => ({ term: c.command, description: c.description }))}
        termHeader={COMMANDS_COPY.commandHeader}
        descriptionHeader={COMMANDS_COPY.descriptionHeader}
        caption={MCP.manageTitle}
      />
    </div>
    <div class="min-w-0">
      <h3 class="sub-title mb-4">{MCP.buildTitle}</h3>
      <FileBlock filename={MCP.fastmcpFilename} code={MCP.fastmcpExample} />
      <p class="mt-3 text-sm muted">
        {MCP.protocolLabel}: <a href={MCP.protocolLink} target="_blank" rel="noopener noreferrer" class="font-mono">{MCP.protocolLink.replace('https://', '')}</a>
      </p>
    </div>
  </div>
</section>
