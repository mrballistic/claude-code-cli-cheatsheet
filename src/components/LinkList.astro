---
/** External links as a ruled list: title, description, and the bare URL. */
import { Icon } from 'astro-icon/components';
import type { Resource } from '@/lib/constants';

interface Props {
  items: Resource[];
  columns?: boolean;
}

const { items, columns = false } = Astro.props;
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<ul class:list={['link-list', { 'md:grid-cols-2 md:gap-x-10': columns }]}>
  {items.map((r) => (
    <li>
      <a href={r.url} class="link-row" target="_blank" rel="noopener noreferrer">
        <span class="link-title">
          {r.title}
          <Icon name="lucide:arrow-up-right" width={14} height={14} aria-hidden="true" />
        </span>
        <span class="link-desc">{r.description}</span>
        <span class="link-url">{host(r.url)}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .link-list { display: grid; }
  .link-row {
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .link-title { display: inline-flex; align-items: center; gap: 0.375rem; font-weight: 700; color: var(--ink); }
  .link-desc { color: var(--ink-2); font-size: 0.9375rem; }
  .link-url { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-3); overflow-wrap: anywhere; }
  .link-row:hover .link-title { color: var(--accent); }
</style>
