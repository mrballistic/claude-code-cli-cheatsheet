---
/** Name, author, one-line summary, and project link for a plugin. */
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  byline: string;
  summary: string;
  url: string;
}

const { title, byline, summary, url } = Astro.props;
const host = url.replace(/^https?:\/\//, '');
---

<header>
  <h3 class="plugin-title">{title}</h3>
  <p class="mt-1 text-sm muted">
    {byline}{' · '}
    <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-mono">
      {host}<Icon name="lucide:arrow-up-right" width={13} height={13} aria-hidden="true" />
    </a>
  </p>
  <p class="mt-3 text-lg text-ink prose-measure">{summary}</p>
</header>

<style>
  .plugin-title { font-family: var(--font-mono); font-weight: 700; font-size: 1.375rem; letter-spacing: -0.02em; }
</style>
