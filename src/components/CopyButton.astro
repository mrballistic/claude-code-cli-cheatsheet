---
/**
 * Copy-to-clipboard button. Always visible (touch has no hover), 44px target,
 * announces success or failure through a shared live region.
 */
import { Icon } from 'astro-icon/components';
import { UI } from '@/lib/constants';

interface Props {
  text: string;
  /** What is being copied, for the accessible name. */
  label?: string;
}

const { text, label = UI.copyAria } = Astro.props;
---

<button
  type="button"
  class="copy-btn"
  data-copy-text={text}
  data-state="idle"
  data-label-copy={UI.copy}
  data-label-copied={UI.copied}
  data-label-failed={UI.copyFailed}
  aria-label={label}
>
  <span class="icon-idle inline-flex" aria-hidden="true"><Icon name="lucide:copy" width={15} height={15} /></span>
  <span class="icon-done hidden" aria-hidden="true"><Icon name="lucide:check" width={15} height={15} /></span>
  <span class="label" aria-hidden="true">{UI.copy}</span>
</button>

<script>
  const live = (() => {
    let el = document.getElementById('copy-status');
    if (!el) {
      el = document.createElement('div');
      el.id = 'copy-status';
      el.setAttribute('role', 'status');
      el.className = 'sr-only';
      document.body.append(el);
    }
    return el;
  })();

  function setState(btn: HTMLButtonElement, state: 'idle' | 'copied' | 'failed') {
    btn.dataset.state = state;
    const done = state !== 'idle';
    btn.querySelector('.icon-idle')?.classList.toggle('hidden', done);
    btn.querySelector('.icon-done')?.classList.toggle('hidden', !done);
    const text =
      state === 'copied' ? btn.dataset.labelCopied : state === 'failed' ? btn.dataset.labelFailed : btn.dataset.labelCopy;
    const label = btn.querySelector('.label');
    if (label) label.textContent = state === 'failed' ? (btn.dataset.labelCopy ?? '') : (text ?? '');
    if (done) live.textContent = text ?? '';
  }

  document.querySelectorAll<HTMLButtonElement>('button.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyText ?? '');
        setState(btn, 'copied');
      } catch {
        setState(btn, 'failed');
      }
      window.setTimeout(() => setState(btn, 'idle'), 2000);
    });
  });
</script>
