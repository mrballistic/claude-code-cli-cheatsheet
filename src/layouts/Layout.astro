---
/**
 * HTML shell: fonts, SEO/social metadata, JSON-LD, analytics, and the
 * page-wide reveal script. Content metadata comes from SITE in constants.
 */
import '@/styles/global.css';
import { SITE, UI } from '@/lib/constants';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ?? new URL('http://localhost');
const pageUrl = new URL(`${base}/`, origin).toString();
const ogImage = new URL(`${base}/og-image.png`, origin).toString();
const faviconHref = `${base}/favicon.svg`;

const author = { '@type': 'Person', '@id': `${SITE.authorUrl}/#person`, name: SITE.author, url: SITE.authorUrl };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${pageUrl}#article`,
      headline: SITE.ogTitle,
      description: SITE.description,
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      image: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      datePublished: SITE.datePublished,
      dateModified: SITE.dateModified,
      inLanguage: 'en',
      keywords: SITE.keywords.join(', '),
      proficiencyLevel: 'Beginner',
      author,
      publisher: author,
      about: {
        '@type': 'SoftwareApplication',
        name: 'Claude Code',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'macOS, Linux, Windows',
        url: 'https://code.claude.com',
      },
      isPartOf: { '@type': 'WebSite', name: SITE.siteName, url: `${SITE.authorUrl}/` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.siteName, item: `${SITE.authorUrl}/` },
        { '@type': 'ListItem', position: 2, name: SITE.title, item: pageUrl },
      ],
    },
  ],
};
// Escape "<" so the JSON can never close the script element early.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <meta name="author" content={SITE.author} />
    <meta name="keywords" content={SITE.keywords.join(', ')} />
    <meta name="theme-color" content="#1a1816" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="author" href={SITE.authorUrl} />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="llms.txt" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={SITE.ogTitle} />
    <meta property="og:description" content={SITE.ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta property="article:author" content={SITE.authorUrl} />
    <meta property="article:published_time" content={SITE.datePublished} />
    <meta property="article:modified_time" content={SITE.dateModified} />
    <meta property="og:updated_time" content={SITE.dateModified} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE.ogTitle} />
    <meta name="twitter:description" content={SITE.ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <script type="application/ld+json" is:inline set:html={jsonLdText} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CWEHQPGMV8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CWEHQPGMV8');
    </script>
  </head>
  <body>
    <a href="#content" class="skip-link">{UI.skipLink}</a>
    <slot />

    <script>
      // Sections fade in once. Content is visible by default (see .js .reveal
      // in global.css), so a script failure never hides the page.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      // Fade the right edge of any command or file that overflows its box, so
      // a clipped line reads as scrollable; the fade drops at the scroll end.
      const scrollers = document.querySelectorAll<HTMLElement>('.cmd-body, .file pre');
      const mark = (el: HTMLElement) => {
        el.classList.toggle('is-overflowing', el.scrollWidth > el.clientWidth + 1);
        el.classList.toggle('at-end', el.scrollLeft + el.clientWidth >= el.scrollWidth - 1);
      };
      scrollers.forEach((el) => {
        mark(el);
        el.addEventListener('scroll', () => mark(el), { passive: true });
      });
      new ResizeObserver(() => scrollers.forEach(mark)).observe(document.body);
    </script>
  </body>
</html>
